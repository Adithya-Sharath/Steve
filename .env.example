# ---- API ----------------------------------------------------------------
# The engine works with ZERO keys. Everything below is optional.
# Operator key for the GLOBAL LLM switch (X-Admin-Key). Unset = the runtime switch is disabled and LLM_ENABLED decides.
# Use a long random value (e.g. 32+ characters). Never reuse a sender key or an API key.
ADMIN_KEY=
LLM_ENABLED=false                 # true = Gemini may *suggest* facts (sender confirms) and power the eval baseline
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite  # lite on purpose: larger models allow only ~20 requests/DAY on a free key. Ids: https://ai.google.dev/gemini-api/docs/models
LLM_TIMEOUT_SECONDS=10             # hard deadline for the optional LLM fact suggestion, then the built-in extractor is used (Gemini refuses < 10 s)
LLM_COOLDOWN_SECONDS=60            # after a failure the LLM is skipped for this long (15 min after a daily-quota error, 60 s for 503/rate limits)

SARVAM_API_KEY=                   # optional speech-to-text (Saaras). Empty = typed replies only
STT_ENABLED=false                 # set to true together with SARVAM_API_KEY to switch voice replies on

DATABASE_URL=sqlite:///./steve.db
PUBLIC_WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Behind a reverse proxy / tunnel: believe X-Forwarded-For and CF-Connecting-IP for the client IP (rate limits).
# Leave false when the API is reachable directly: those headers are client-controlled and would be spoofable.
TRUST_PROXY=false
# extra proxy hops to skip when reading X-Forwarded-For from the right (comma list of IPs/CIDRs)
# TRUSTED_PROXIES=

# engine tuning
UNCLEAR_THRESHOLD=0.6
# STEVE_EMBEDDINGS=1               # opt-in embedding fallback for condition facts (needs sentence-transformers; disabled until calibrated)

# abuse guard: max replies per minute from one client to one reader link
REPLY_RATE_LIMIT=12

# where the API reads scenario data and eval results (defaults to ./data and ./eval/results; the Docker image sets them)
# STEVE_DATA_DIR=
# STEVE_EVAL_DIR=

# ---- WEB ----------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
